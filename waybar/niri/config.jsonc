{
    "spacing": 10,
    "height": 25,
    "margin": "6 4 0 4",
    "modules-left": ["group/network","custom/vpn","custom/public_ip","backlight"],
    "modules-center": ["clock","wlr/taskbar"],
    "modules-right": ["group/hardware","battery","pulseaudio","tray"],
    // "group/network": {
	// 	"orientation": "inherit",
    //     "drawer": {
    //     "transition-duration": 500,
    //     "children-class": "",
    //     "transition-left-to-right": true
    //     },
	// 	"modules": [
    //         "network",
    //         "custom/network"
	// 	]
	// },
    "group/network": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "network-details",
            "transition-left-to-right": true
        },
        "modules": [
            "network",        // The Smart Icon (Handle)
            "network#text"    // The Detail Drawer (Hover)
        ]
    },

    "network": {
        // This single module detects WiFi, WWAN, or Ethernet automatically
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰲜 ",
        // Custom icon for your TPG WWAN connection
        "format-alt": "󰩟 ", 
        "tooltip-format": "{ifname}: {ipaddr}\nUsage: {bandwidthTotalBytes}",
        "interface": "wl*"
    },

    "network#text": {
        "interface": "wl*",
        "format-wifi": "{essid} {ipaddr} 󱄚 {ifname}",
        "format-ethernet": "WWAN {ipaddr} 󱄚 {ifname}",
        "format-linked": "󰖪 Kill Switch Active",
        "format-disconnected": "Disconnected",
        "tooltip": false
},

    "custom/public_ip": {
        "exec": "curl -s https://api.ipify.org",
        "interval": 1800,
        "format": "󰖟 {}", 
        "on-click": "pkill -RTMIN+8 waybar", 
        "signal": 8,
        "tooltip": false
    },
    "group/hardware": {
		"orientation": "inherit",
        "drawer": {
        "transition-duration": 500,
        "children-class": "",
        "transition-left-to-right": false
        },
		"modules": [
            "cpu",
            "memory"
		]
	},

    "battery": {
        "format": "{icon}{capacity}%",
        "format-icons": ["  ", "  ", "  ", "  ", "  "]
    },
        "clock": {
        "format": "{:%H:%M}",
        "format-alt": "   {:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "year",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#8aadf4'><b>{}</b></span>",
                              "days":       "<span color='#cad3f5'><b>{}</b></span>",
                              "weeks":      "<span color='#8bd5ca'><b>W{}</b></span>",
                              "weekdays":   "<span color='#b7bdf8'><b>{}</b></span>",
                              "today":      "<span color='#ed8796'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "tz_up",
                    "on-scroll-down": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "backlight": {
    "device": "intel_backlight",
    // "format": "{icon}{percent}%",
    "format": "{percent}%",
    "format-icons": ["  ", "  ", "  ", "  "]
    },
    "cpu": {
     "interval": 5,
     "format": "{avg_frequency} GHz"
    },
    "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20, // Increased for better visibility
        "icon-theme": "Numix-Circle",
        "tooltip": false,
        "on-click": "activate",
        "on-click-middle": "close",
        "sort-by-app-id": true, // Keeps icons in a more predictable order
        "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
        "Firefox Web Browser": "Firefox",
        "Foot Server": "Terminal"
    }
    },
    "custom/network": {
        "exec": "$HOME/.config/waybar/scripts/wifi-status.sh",
        "interval": 5,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "custom/vpn": {
        "exec": "~/.config/niri/scripts/vpn_status.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    // Module 2: The Text (Drawer Content)

    // the old network#text
    // "network#text": {
    //     "format": " {ifname}  {essid}", // Space at start for padding
    //     "format-wifi": " {ifname}  {essid} {ipaddr}",
    //     // Ethernet/WWAN usually don't have SSID, so we show IP
    //     "format-ethernet": " {ifname}  {ipaddr}",
    //     "format-disconnected": " Offline",
    //     // "tooltip-format": "{ifname} via {ipaddr}",
    //     "tooltip": false,
    //     "family": "ipv4"
    // },
    "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "  ",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "  ",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "  ",
        "headphone": "  ",
        "hands-free": "  ",
        "headset": "  ",
        "phone": "  ",
        "phone-muted": "  ",
        "portable": "  ",
        "car": "  ",
        "default": ["  ", "  "]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
    },
    "tray": {
    "icon-size": 12,
    "spacing": 8,
    "icons": {
        "blueman": "bluetooth"    
    }
    }
}
