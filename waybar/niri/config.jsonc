{
    "spacing": 10,
    "height": 28,
    "margin": "6 4 0 4",
    "modules-left": ["group/leftmain"],
    "modules-center": ["clock", "wlr/taskbar"],
    "modules-right": ["group/hardware", "battery", "pulseaudio", "tray"],

    // -------------------------------------------------------------------------
    // Left Bar - Main Group
    // -------------------------------------------------------------------------
    "group/leftmain": {
        "orientation": "inherit",
        "spacing": 10,
        "modules": [
            "group/connection",
            "custom/vpn_provider",
            "group/vpn_server",
            "group/vpn_exit",
            "custom/carrier_ip",
            "group/dns_group",
            "backlight"
        ]
    },

    // -------------------------------------------------------------------------
    // Connection Icon drawer — icon handle, hover shows physical details
    // -------------------------------------------------------------------------
    "group/connection": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "conn-details",
            "transition-left-to-right": true
        },
        "modules": [
            "network",
            "custom/conn_details"
        ]
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰲜 ",
        "tooltip": false
    },

    "custom/conn_details": {
        "exec": "~/.config/niri/scripts/conn_details.sh",
        "interval": 10,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // VPN Provider — always visible, no hover
    // -------------------------------------------------------------------------
    "custom/vpn_provider": {
        "exec": "~/.config/niri/scripts/vpn_provider.sh",
        "interval": 5,
        "format": "{}",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // VPN Server drawer — handle shows server code, hover reveals city
    // -------------------------------------------------------------------------
    "group/vpn_server": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "vpn-details",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/vpn_server",
            "custom/vpn_city"
        ]
    },

    "custom/vpn_server": {
        "exec": "~/.config/niri/scripts/vpn_server.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    "custom/vpn_city": {
        "exec": "~/.config/niri/scripts/vpn_city.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // VPN Exit IP drawer — handle shows exit IP, hover reveals tunnel IP
    // -------------------------------------------------------------------------
    "group/vpn_exit": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "vpn-details",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/vpn_exit",
            "custom/vpn_tunnel"
        ]
    },

    "custom/vpn_exit": {
        "exec": "~/.config/niri/scripts/vpn_exit.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    "custom/vpn_tunnel": {
        "exec": "~/.config/niri/scripts/vpn_tunnel.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // Carrier IP — WWAN or WiFi icon + IP, no hover
    // -------------------------------------------------------------------------
    "custom/carrier_ip": {
        "exec": "~/.config/niri/scripts/carrier_ip.sh",
        "interval": 10,
        "format": "{}",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // DNS drawer — upstream handle, hover reveals stub
    // -------------------------------------------------------------------------
    "group/dns_group": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "dns-details",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/dns",
            "custom/dns_stub"
        ]
    },

    "custom/dns": {
        "exec": "~/.config/niri/scripts/dns_ip.sh",
        "interval": 30,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    "custom/dns_stub": {
        "exec": "~/.config/niri/scripts/dns_stub.sh",
        "interval": 30,
        "format": "{}",
        "return-type": "json",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // Backlight
    // -------------------------------------------------------------------------
    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}%",
        "format-icons": ["  ", "  ", "  ", "  "]
    },

    // -------------------------------------------------------------------------
    // Hardware Group — CPU handle, memory drawer
    // -------------------------------------------------------------------------
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "",
            "transition-left-to-right": false
        },
        "modules": ["cpu", "memory"]
    },

    "cpu": {
        "interval": 5,
        "format": "{avg_frequency} GHz"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G/{total:0.1f}G"
    },

    // -------------------------------------------------------------------------
    // Battery
    // -------------------------------------------------------------------------
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["  ", "  ", "  ", "  ", "  "]
    },

    // -------------------------------------------------------------------------
    // Clock
    // -------------------------------------------------------------------------
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "   {:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#8aadf4'><b>{}</b></span>",
                "days":     "<span color='#cad3f5'><b>{}</b></span>",
                "weeks":    "<span color='#8bd5ca'><b>W{}</b></span>",
                "weekdays": "<span color='#b7bdf8'><b>{}</b></span>",
                "today":    "<span color='#ed8796'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // -------------------------------------------------------------------------
    // Taskbar
    // -------------------------------------------------------------------------
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "icon-theme": "Numix-Circle",
        "tooltip": false,
        "on-click": "activate",
        "on-click-middle": "close",
        "sort-by-app-id": true,
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    // -------------------------------------------------------------------------
    // Pulseaudio
    // -------------------------------------------------------------------------
    "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "  ",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "  ",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "  ",
        "headphone": "  ",
        "hands-free": "  ",
        "headset": "  ",
        "phone": "  ",
        "phone-muted": "  ",
        "portable": "  ",
        "car": "  ",
        "default": ["  ", "  "]
    },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    // -------------------------------------------------------------------------
    // Tray
    // -------------------------------------------------------------------------
    "tray": {
        "icon-size": 12,
        "spacing": 8,
        "icons": {
            "blueman": "bluetooth"
        }
    }
}
